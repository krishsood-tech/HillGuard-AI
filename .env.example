# HillGuard AI — copy to .env and fill values. Never commit secrets.

# Set true for academic demonstration (sample incidents, labeled demo weather/routing/AI)
DEMO_MODE=true

# SQLite (default, easy local demo) or PostgreSQL+PostGIS:
# postgresql+psycopg://hillguard:hillguard@localhost:5432/hillguard
DATABASE_URL=sqlite:///./data/hillguard.db

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Optional: OpenWeatherMap. If empty, Open-Meteo is used (no key). If that fails, labeled demo weather.
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Optional custom tiles. Default: Carto Voyager (OSM-compatible).
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional routing. If empty, public OSRM is tried, then labeled demo routing.
ROUTING_API_KEY=
OSRM_URL=https://router.project-osrm.org

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=5

# Official information links (do not invent additional authorities)
EMERGENCY_IMD_URL=https://mausam.imd.gov.in/
EMERGENCY_NDMA_URL=https://ndma.gov.in/
EMERGENCY_HPSDMA_URL=https://hpsdma.nic.in/
